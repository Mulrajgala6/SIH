# ── DAKSYNC backend environment ─────────────────────────────────────────────
# Copy to ".env" and adjust as needed:   cp .env.example .env

# Database
# Default zero-config SQLite (works immediately, no services required):
DATABASE_URL=sqlite:///./daksync.db
# Recommended PostgreSQL (start it with `docker compose up -d db` from repo root):
# DATABASE_URL=postgresql+psycopg2://daksync:daksync@localhost:5432/daksync

# CORS — origin of the Next.js frontend
FRONTEND_ORIGIN=http://localhost:3000

# Geocoding (Phase 5)
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=daksync-prototype/0.1 (SIH2026)

# OTP (Phase 9)
OTP_TTL_SECONDS=600
OTP_LENGTH=4
