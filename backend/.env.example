# ── DAKSYNC backend environment ─────────────────────────────────────────────
# Copy to ".env" and adjust as needed:   cp .env.example .env
# Every value below has a sensible built-in default — an empty .env still works.

# --- Database ---
# Default zero-config SQLite (works immediately, no services required):
DATABASE_URL=sqlite:///./daksync.db
# Recommended PostgreSQL (start it with `docker compose up -d db` from repo root,
# and install the driver from requirements-optional.txt):
# DATABASE_URL=postgresql+psycopg2://daksync:daksync@localhost:5432/daksync

# --- Demo mode ---
# When true, conveniences for presentations are enabled — notably the delivery
# OTP is returned in the API response (and shown in the postman app) instead of
# only being sent via a real SMS gateway. Set to false for any real deployment.
DEMO_MODE=true

# --- Security ---
# Secret used to sign lightweight bearer tokens (stdlib HMAC). CHANGE THIS in
# any non-local deployment.
SECRET_KEY=daksync-dev-secret-change-me
TOKEN_TTL_SECONDS=43200   # 12 hours

# --- CORS / frontend ---
FRONTEND_ORIGIN=http://localhost:3000

# --- Geocoding (Phase 5) ---
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=daksync-prototype/0.1 (SIH2026)

# --- OTP (Phase 9) ---
OTP_TTL_SECONDS=3600      # 1 hour — comfortable for a live demo, still expires
OTP_LENGTH=4
OTP_MAX_ATTEMPTS=5
